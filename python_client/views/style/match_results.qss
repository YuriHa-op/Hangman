/* Hangman Match Results & Details Style - Modern Theme */

/* General styling for the results view */
QtMultiplayerGameResultsView {
    background-color: #1A1A2E;
    color: #FFFFFF;
}

/* Header label styling */
#header_label {
    font-family: "Arial", sans-serif;
    font-size: 28px;
    font-weight: bold;
    color: #FFD700; /* Gold color */
    margin-bottom: 15px;
    text-transform: uppercase;
    background-color: #800000; /* Maroon color */
    padding: 10px;
    border-radius: 5px;
}

/* Results table styling */
#table {
    background-color: #232342;
    alternate-background-color: #2F2A5A;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    gridline-color: #1A1A2E;
    font-size: 15px;
}

#table::item {
    padding: 10px;
    border: none;
}

#table::item:selected {
    background-color: #4B4688;
    color: #FFFFFF;
}

/* Table header styling */
QHeaderView::section {
    background-color: #1A1A2E;
    color: #FFD700; /* Gold */
    font-weight: bold;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #FFD700;
}

/* First place row styling */
#table QTableWidgetItem[row="0"] {
    background-color: rgba(255, 215, 0, 0.2); /* Gold with opacity */
    font-weight: bold;
}

/* Button styling */
#view_details_button, #back_button {
    background-color: #3D376E;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
    margin-top: 5px;
    min-height: 35px;
}

#view_details_button:hover, #back_button:hover {
    background-color: #4B4688;
}

#view_details_button:pressed, #back_button:pressed {
    background-color: #2C2850;
}

#view_details_button:disabled {
    background-color: #2A2A40;
    color: #6A6A8A;
}

/* Special styling for back button */
#back_button {
    background-color: #E94560; /* A contrasting pink/red */
}

#back_button:hover {
    background-color: #FC5A75;
}

#back_button:pressed {
    background-color: #D43A54;
}

/* Match Details Dialog Styling */
MatchDetailsDialog {
    background-color: #1A1A2E;
    color: #FFFFFF;
    border: 2px solid #FFD700; /* Gold border for frameless dialog */
    border-radius: 8px;
}

#winner_label {
    font-family: "Arial", sans-serif;
    font-size: 20px;
    font-weight: bold;
    color: #FFD700; /* Gold */
    margin-bottom: 10px;
}

#players_list_label {
    font-size: 16px;
    color: #FFFFFF;
    margin-bottom: 15px;
}

/* Scrollable area for round results */
#scroll_area, #scroll_widget {
    background-color: transparent;
    border: none;
}

/* OK button in details dialog */
#ok_button {
    background-color: #3D376E;
    color: #FFFFFF;
    border: none;
    border-radius: 5px;
    padding: 10px 25px;
    font-size: 14px;
    font-weight: bold;
    min-width: 100px;
    margin-top: 10px;
    margin-bottom: 10px;
}

#ok_button:hover {
    background-color: #4B4688;
}

#ok_button:pressed {
    background-color: #2C2850;
}

/* Round Result Widget Styling */
RoundResultWidget {
    background-color: #232342;
    border-radius: 8px;
    margin: 5px 0;
    padding: 10px;
}

RoundResultWidget:hover {
    background-color: #2F2A5A;
}

#round_label {
    font-family: "Arial", sans-serif;
    font-size: 16px;
    color: #FFFFFF;
}

#winner_label {
    font-family: "Arial", sans-serif;
    font-size: 14px;
    color: #FFD700; /* Gold */
}

/* Special animation for the winning player */
@keyframes winner_glow {
    0% { color: #FFFFFF; }
    50% { color: #FFD700; }
    100% { color: #FFFFFF; }
}

.winner_animation {
    animation: winner_glow 2s infinite;
} 