/* JJK Themed Dialog Styling */

QDialog {
    background-color: rgb(20, 20, 20); /* Solid dark background */
    border: 2px solid #FFD700; /* Gold/Yellow border */
    border-radius: 15px;
    color: white;
    font-family: "JujutsuKaisen";
}

QLabel {
    color: white;
    font-size: 20px;
    padding: 10px;
}

#opponent_label, #result_label {
    font-size: 24px;
    font-weight: bold;
    color: #FFD700;
}

#countdown_label {
    font-size: 18px;
    color: #cccccc;
}

QPushButton {
    background-color: #FFD700;
    color: #000000;
    border: none;
    border-radius: 5px;
    padding: 10px 25px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #ffffff;
} 