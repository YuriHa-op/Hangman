/*
 * Minecraft-themed QSS stylesheet
 * By Gemini
 */

QWidget#LoginView {
    background-color: #3B3B3B; /* Dark stone grey */
}

QLabel {
    color: #FFFFFF; /* White text */
    font-family: "Courier New", "Lucida Console", monospace;
    font-size: 14px;
    text-shadow: 2px 2px #222222;
}

QLabel#title_label {
    font-size: 20px;
    font-weight: bold;
    color: #FFAA00; /* Gold-ish color like Minecraft logo */
    padding-bottom: 10px;
}

QLineEdit {
    background-color: #555555; /* Darker grey */
    border: 2px solid #222222; /* Inset-like border */
    color: #FFFFFF;
    font-family: "Courier New", "Lucida Console", monospace;
    padding: 5px;
    font-size: 14px;
    border-radius: 0px; /* Sharp corners */
}

QLineEdit:focus {
    border: 2px solid #777777;
    outline: none; /* No default outline */
}

QPushButton {
    background-color: #707070; /* Stone grey */
    color: #DDDDDD; /* Light grey text */
    border-width: 2px;
    border-style: solid;
    border-color: #898989 #5C5C5C #5C5C5C #898989; /* 3D effect */
    padding: 8px 15px;
    font-family: "Courier New", "Lucida Console", monospace;
    font-size: 14px;
    font-weight: bold;
    outline: none; /* No default outline */
}

QPushButton:hover {
    background-color: #828282; /* Lighter grey */
    color: #FFFFA0; /* Yellowish glow on hover */
}

QPushButton:pressed {
    background-color: #5C5C5C; /* Darker grey when pressed */
    border-color: #5C5C5C #898989 #898989 #5C5C5C; /* Invert 3D effect */
    padding-top: 10px; /* Push text down */
    padding-bottom: 6px;
} 