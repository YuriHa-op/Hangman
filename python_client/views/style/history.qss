/* Jujutsu Kaisen Quest Screen Theme */

MatchHistoryView,
#title_label,
#mission_tabs_container QPushButton,
#mission_list_table,
#briefing_container QLabel,
#rounds_table,
#back_button,
QHeaderView::section {
    font-family: "Jujutsu Kaisen";
}

/* Main title */
#title_label {
    font-size: 36px;
    color: #FFD700; /* Gold/Yellow */
    font-weight: bold;
    text-transform: uppercase;
}

/* Tab buttons for mission types */
#mission_tabs_container QPushButton {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 2px solid #FFD700;
    padding: 10px 20px;
    font-size: 18px;
    font-weight: bold;
}

#mission_tabs_container QPushButton:checked,
#mission_tabs_container QPushButton:hover {
    background-color: #FFD700;
    color: #000000;
}

/* Container for the two main panels */
#main_content_container {
    background: transparent;
}

/* Left panel: Mission list */
#mission_list_container {
    background-color: rgba(42, 42, 42, 0.8);
    border: 2px solid #4a4a4a;
    border-radius: 5px;
}

#mission_list_table {
    background-color: transparent;
    color: #ffffff;
    gridline-color: #4a4a4a;
    font-size: 16px;
}

QHeaderView::section {
    background-color: #1a1a1a;
    color: #FFD700;
    padding: 5px;
    border: 1px solid #4a4a4a;
    font-size: 18px;
    font-weight: bold;
}

#mission_list_table::item {
    padding: 15px;
    border-bottom: 1px solid #4a4a4a;
}

#mission_list_table::item:selected {
    background-color: #FFD700;
    color: #000000;
}

/* Right panel: Mission briefing/details */
#briefing_container {
    background-color: rgba(42, 42, 42, 0.8);
    border: 2px solid #4a4a4a;
    border-radius: 5px;
    padding: 15px;
}

#briefing_title_label, #briefing_details_label {
    color: #FFD700;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 10px;
}

#briefing_content_label {
    color: #ffffff;
    font-size: 16px;
    line-height: 1.5;
    padding: 10px;
    background-color: #1a1a1a;
    border-radius: 3px;
}
#rounds_table {
    background-color: transparent;
    color: #ffffff;
}

/* Back Button */
#back_button {
    background-color: #1a1a1a;
    color: #FFD700;
    border: 2px solid #FFD700;
    border-radius: 5px;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: bold;
}

#back_button:hover {
    background-color: #FFD700;
    color: #000000;
} 