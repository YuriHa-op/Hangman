/* 
 * Minecraft-themed Main Menu Stylesheet 
 */

/* Main container style - background is handled in code */
QWidget#MainMenuView {
    background-color: #3B3B3B; /* Fallback color */
}

/* Big centered buttons */
#center_buttons_widget QPushButton {
    background-color: #222222;
    color: #DDDDDD;
    border-width: 2px;
    border-style: solid;
    border-color: #444444 #111111 #111111 #444444;
    padding: 10px;
    font-family: "Minecraftia";
    font-size: 14px;
    min-height: 30px;
}

#center_buttons_widget QPushButton:hover {
    background-color: #333333;
    color: #FFFFA0;
}

#center_buttons_widget QPushButton:pressed {
    background-color: #111111;
    border-color: #111111 #444444 #444444 #111111;
    padding-top: 12px;
    padding-bottom: 8px;
}

/* Style the smaller side-by-side buttons differently */
#match_history_button, #logout_button {
    padding: 5px 10px;
    font-size: 12px;
    min-height: 25px;
}

#match_history_button:pressed, #logout_button:pressed {
    padding-top: 7px;
    padding-bottom: 3px;
}

/* Splash text over the logo */
#splash_label {
    color: #FEC80A; /* Yellow */
    font-family: "Minecraftia";
    font-size: 18px;
    font-weight: bold;
    text-shadow: 2px 2px #3E3E3E;
    background-color: transparent; /* Make sure it has no background */
}

/* Footer text labels */
#footer_left_label, #footer_right_label {
    color: white;
    font-family: "Minecraftia";
    font-size: 12px;
    background-color: transparent;
} 