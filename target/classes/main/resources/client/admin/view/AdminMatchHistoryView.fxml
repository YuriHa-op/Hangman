<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="18.0" prefWidth="800.0" prefHeight="600.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.admin.controller.AdminMatchHistoryController" 
      stylesheets="@AdminMatchHistory.css" 
      style="-fx-background-image: url('game.png'); -fx-background-size: cover;">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>
    <Text text="Match History" styleClass="title-text" />

    <HBox alignment="CENTER_LEFT" spacing="10.0" prefWidth="760.0">
        <padding>
            <Insets bottom="5.0"/>
        </padding>
        <Label text="History Type:" styleClass="history-type-label" />
        <ComboBox fx:id="historyTypeComboBox" promptText="Select Type" styleClass="history-type-combo-box" />
    </HBox>

    <TableView fx:id="historyTable" prefHeight="450.0" prefWidth="760.0">
        <columns>
            <TableColumn fx:id="colGameId" text="Game ID" prefWidth="180"/>
            <TableColumn fx:id="colDateTime" text="Date/Time" prefWidth="170"/>
            <TableColumn fx:id="colPlayers" text="Players Involved" prefWidth="200"/>
            <TableColumn fx:id="colWinner" text="Winner" prefWidth="120.0" />
            <TableColumn fx:id="colRounds" text="Rounds" prefWidth="80.0" />
            <TableColumn fx:id="colDetails" text="Details" prefWidth="100.0" />
        </columns>
    </TableView>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="closeButton" text="Close" styleClass="admin-button" /> 
    </HBox>
</VBox> 