<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: #2B2B2B; -fx-padding: 20;" stylesheets="@../GameView.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="client.player.controller.results.GameResultsViewController">
    <children>
        <Label text="Game Results" textFill="GOLD">
            <font>
                <Font name="Minecraftia" size="36.0" />
            </font>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>
        <TableView fx:id="resultsTable" prefHeight="250.0">
            <columns>
                <TableColumn fx:id="rankColumn" prefWidth="75.0" text="Rank" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="playerColumn" prefWidth="250.0" text="Player" />
                <TableColumn fx:id="scoreColumn" prefWidth="150.0" text="Score" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Button fx:id="okButton" onAction="#handleOkButton" text="OK" styleClass="menu-button">
            <font>
                <Font name="Minecraftia" size="18.0" />
            </font>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox> 