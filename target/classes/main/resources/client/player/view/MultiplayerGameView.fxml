<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="root" style="-fx-background-image: url('blou.png'); -fx-background-size: cover;" stylesheets="@GameView.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="client.player.controller.MultiplayerGameViewController">
    <VBox alignment="TOP_CENTER" spacing="10.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <Label fx:id="roundWinnerBanner" visible="false" style="-fx-font-size: 22px; -fx-font-family: 'Minecraftia'; -fx-text-fill: #ffdd00; -fx-background-color: rgba(0,0,0,0.7); -fx-padding: 8 24 8 24; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #ffdd00; -fx-border-width: 2px;" />
        <Text fill="RED" styleClass="title-text" text="What's The Word? - Multiplayer">
            <VBox.margin>
                <Insets bottom="10" />
            </VBox.margin>
        </Text>
        
        <!-- Player Scores Panel -->
        <HBox fx:id="scoresPanel" alignment="CENTER" spacing="20" styleClass="scores-panel">
            <VBox.margin>
                <Insets bottom="10" />
            </VBox.margin>
            <!-- Scores will be added dynamically as 'player:score' -->
        </HBox>
        
        <!-- Hangman Image View -->
        <ImageView fx:id="hangmanImage" preserveRatio="true" visible="true" fitHeight="180" fitWidth="120" />
        
        <Label fx:id="wordDisplay" styleClass="word-display" text="_ _ _ _" />
        
        <!-- Timer and Round Info -->
        <VBox alignment="CENTER" spacing="2">
            <Label fx:id="roundLabel" styleClass="round-label" text="Round: 1" />
            <HBox alignment="CENTER" spacing="20">
                <Label fx:id="timerLabel" styleClass="timer-label" text="30" />
            </HBox>
        </VBox>
        
        <!-- Screen Keyboard -->
        <VBox fx:id="keyboardGrid" alignment="CENTER" spacing="5" visible="false" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <!-- First row -->
            <HBox alignment="CENTER" spacing="5">
                <Button fx:id="keyQ" onAction="#handleKeyPress" styleClass="keyboard-key" text="Q" />
                <Button fx:id="keyW" onAction="#handleKeyPress" styleClass="keyboard-key" text="W" />
                <Button fx:id="keyE" onAction="#handleKeyPress" styleClass="keyboard-key" text="E" />
                <Button fx:id="keyR" onAction="#handleKeyPress" styleClass="keyboard-key" text="R" />
                <Button fx:id="keyT" onAction="#handleKeyPress" styleClass="keyboard-key" text="T" />
                <Button fx:id="keyY" onAction="#handleKeyPress" styleClass="keyboard-key" text="Y" />
                <Button fx:id="keyU" onAction="#handleKeyPress" styleClass="keyboard-key" text="U" />
                <Button fx:id="keyI" onAction="#handleKeyPress" styleClass="keyboard-key" text="I" />
                <Button fx:id="keyO" onAction="#handleKeyPress" styleClass="keyboard-key" text="O" />
                <Button fx:id="keyP" onAction="#handleKeyPress" styleClass="keyboard-key" text="P" />
            </HBox>
            <!-- Second row -->
            <HBox alignment="CENTER" spacing="5">
                <Button fx:id="keyA" onAction="#handleKeyPress" styleClass="keyboard-key" text="A" />
                <Button fx:id="keyS" onAction="#handleKeyPress" styleClass="keyboard-key" text="S" />
                <Button fx:id="keyD" onAction="#handleKeyPress" styleClass="keyboard-key" text="D" />
                <Button fx:id="keyF" onAction="#handleKeyPress" styleClass="keyboard-key" text="F" />
                <Button fx:id="keyG" onAction="#handleKeyPress" styleClass="keyboard-key" text="G" />
                <Button fx:id="keyH" onAction="#handleKeyPress" styleClass="keyboard-key" text="H" />
                <Button fx:id="keyJ" onAction="#handleKeyPress" styleClass="keyboard-key" text="J" />
                <Button fx:id="keyK" onAction="#handleKeyPress" styleClass="keyboard-key" text="K" />
                <Button fx:id="keyL" onAction="#handleKeyPress" styleClass="keyboard-key" text="L" />
            </HBox>
            <!-- Third row -->
            <HBox alignment="CENTER" spacing="5">
                <Button fx:id="keyZ" onAction="#handleKeyPress" styleClass="keyboard-key" text="Z" />
                <Button fx:id="keyX" onAction="#handleKeyPress" styleClass="keyboard-key" text="X" />
                <Button fx:id="keyC" onAction="#handleKeyPress" styleClass="keyboard-key" text="C" />
                <Button fx:id="keyV" onAction="#handleKeyPress" styleClass="keyboard-key" text="V" />
                <Button fx:id="keyB" onAction="#handleKeyPress" styleClass="keyboard-key" text="B" />
                <Button fx:id="keyN" onAction="#handleKeyPress" styleClass="keyboard-key" text="N" />
                <Button fx:id="keyM" onAction="#handleKeyPress" styleClass="keyboard-key" text="M" />
            </HBox>
        </VBox>
    </VBox>
    
    <!-- Exit Game Button (top right) -->
    <AnchorPane pickOnBounds="false" StackPane.alignment="TOP_RIGHT">
        <ImageView fx:id="exitGameButton"
                   fitWidth="48" fitHeight="48" pickOnBounds="true" preserveRatio="true"
                   onMouseClicked="#handleExitGame" />
    </AnchorPane>
</StackPane> 