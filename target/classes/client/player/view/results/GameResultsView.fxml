<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="root" alignment="CENTER" spacing="10" prefWidth="400" prefHeight="350" stylesheets="@../GameView.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <Label text="Game Over" styleClass="header-label">
        <font>
            <Font name="Minecraftia" size="24.0" />
        </font>
    </Label>

    <TableView fx:id="scoresTable" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="rankColumn" prefWidth="75.0" text="Rank" />
            <TableColumn fx:id="playerColumn" prefWidth="200.0" text="Player" />
            <TableColumn fx:id="scoreColumn" prefWidth="100.0" text="Score" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="detailsButton" text="View Details" onAction="#handleDetailsButton" />
        <Button fx:id="okButton" text="OK" onAction="#handleOkButton" />
    </HBox>
</VBox> 